# ---- Moody edge: development defaults (ESP32-S3-BOX-3) ----
CONFIG_IDF_TARGET="esp32s3"
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.1.0"

# Flash / PSRAM (BOX-3: 16 MB flash, 16 MB octal PSRAM)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Partitions (offset moved to leave room for a Secure Boot V2 bootloader)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# OTA with automatic rollback if the new firmware cannot reach the gateway
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console on the native USB port (also used by the provisioning tool)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Wake word: WakeNet9 "Hi ESP" (runs on-device, no audio leaves before it fires)
CONFIG_SR_WN_WN9_HIESP=y
CONFIG_SR_NSN_NONE=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y

# TLS: verify certificate validity dates (time comes from SNTP), TLS 1.2 + 1.3, no legacy
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_ESP_TLS_INSECURE=n
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# Wi-Fi: WPA3-SAE capable, PMF
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# LVGL fonts (large, readable text)
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
