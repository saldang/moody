{
  "cacheDirectory": "/models",
  "serve": {
    "load": { "lazy": false, "concurrency": 1, "timeoutMs": 3600000 },
    "models": {
      "moody-llm": {
        "model": "QWEN3_4B_INST_Q4_K_M",
        "preload": true,
        "config": { "ctx_size": 8192, "tools": true, "reasoning_budget": 0 }
      },
      "moody-embed": {
        "src": "https://huggingface.co/ggml-org/bge-m3-Q8_0-GGUF/resolve/main/bge-m3-q8_0.gguf",
        "type": "embeddings",
        "preload": true
      },
      "moody-stt": {
        "model": "PARAKEET_TRANSCRIBEPSY_250M_Q8_0",
        "preload": true
      },
      "moody-tts": {
        "model": "TTS_MULTILINGUAL_SUPERTONIC3_Q8_0",
        "type": "tts",
        "preload": true,
        "config": { "ttsEngine": "supertonic", "language": "it", "voice": "F1" }
      }
    },
    "openai": {
      "audio": { "speech": { "defaultVoice": "F1", "maxInputChars": 1000 } }
    }
  }
}
