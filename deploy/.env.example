# Copy to deploy/.env (scripts/setup.sh does it for you). Never commit .env.

# --- general ---------------------------------------------------------------
TZ=Europe/Rome
MOODY_LOCALE=it
MOODY_LOG_LEVEL=INFO
# uid/gid that owns deploy/pki, deploy/secrets, deploy/data (set by setup.sh)
MOODY_UID=1000
MOODY_GID=1000
# Bind the gateway to the IoT VLAN address of the server, not 0.0.0.0, when possible
MOODY_GATEWAY_BIND=0.0.0.0
# ntfy is published on localhost only; use your LAN/VPN IP to reach it from phones
MOODY_NTFY_BIND=127.0.0.1

# --- pinned images (update deliberately, read changelogs) ----------------------
MOODY_VERSION=0.1.0
OLLAMA_VERSION=0.40.18
WHISPER_VERSION=3.9.1
PIPER_VERSION=2.5.4
NTFY_VERSION=v2.38.2

# --- AI models (all Apache-2.0 / MIT, see docs/10-licenze.md) --------------------
MOODY_LLM_BACKEND=ollama            # ollama | openai (vLLM, llama.cpp server, LocalAI)
MOODY_LLM_URL=http://ollama:11434
MOODY_LLM_MODEL=qwen3:8b            # small hardware: qwen3:4b
MOODY_EMBED_MODEL=bge-m3            # empty = no knowledge base
MOODY_EMBED_BACKEND=                # default: same as MOODY_LLM_BACKEND
MOODY_EMBED_URL=                    # default: same as MOODY_LLM_URL
MOODY_GUARD_MODEL=                  # e.g. granite3-guardian:2b (optional safety classifier)
WHISPER_MODEL=small-int8            # tiny-int8 on very small CPUs, medium-int8 with a GPU
PIPER_VOICE=it_IT-paola-medium      # check the voice's MODEL_CARD license

# --- behaviour & privacy -----------------------------------------------------------
MOODY_RETENTION_DAYS=30             # mood journal / reminders hard retention
MOODY_LOG_TRANSCRIPTS=false         # keep false in production
MOODY_ESCALATION=ask                # ask | auto (auto notifies on distress without asking)
MOODY_NTFY_TOPIC=                   # random, generated by setup.sh

# --- optional: Home Assistant MCP server ---------------------------------------------
# e.g. http://homeassistant.lan:8123/api/mcp  (token in deploy/secrets/ha_token)
MOODY_HA_MCP_URL=

# --- enterprise only (compose.enterprise.yaml) ----------------------------------------
KEYCLOAK_VERSION=26.8.2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
MOODY_GATEWAY_CLIENT_SECRET=
