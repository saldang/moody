# Copy to deploy/.env (scripts/setup.sh does it for you). Never commit .env.

# --- general ---------------------------------------------------------------
TZ=Europe/Rome
MOODY_LOCALE=it
MOODY_LOG_LEVEL=INFO
# uid/gid that owns deploy/pki, deploy/secrets, deploy/data (set by setup.sh)
MOODY_UID=1000
MOODY_GID=1000
# Bind the gateway to the IoT VLAN address of the server, not 0.0.0.0, when possible
MOODY_GATEWAY_BIND=0.0.0.0
# ntfy is published on localhost only; use your LAN/VPN IP to reach it from phones
MOODY_NTFY_BIND=127.0.0.1

# --- pinned images (update deliberately, read changelogs) ----------------------
MOODY_VERSION=0.1.0
QVAC_CLI_VERSION=0.20.0             # @qvac/cli (Tether), built into moody/qvac
NTFY_VERSION=v2.38.2
# classic stack only (compose.classic.yaml / compose.piper.yaml)
OLLAMA_VERSION=0.40.18
WHISPER_VERSION=3.9.1
PIPER_VERSION=2.5.4

# --- AI runtime: QVAC by Tether (docs/13-qvac.md) -------------------------------------
# Models are declared in config/qvac/<QVAC_CONFIG>; brain/gateway refer to them by alias.
QVAC_CONFIG=qvac.config.json        # qvac.https.config.json = Hugging Face only (no P2P)
QVAC_MEM_LIMIT=12g
MOODY_LLM_MODEL=moody-llm           # alias in the QVAC config
MOODY_LLM_TEMPERATURE=0.2           # low = more reliable tool calls
MOODY_EMBED_MODEL=moody-embed       # "none" disables the knowledge base
MOODY_RAG_MIN_SCORE=0.55            # tuned for bge-m3
# optional Granite Guardian (needs an Ollama endpoint)
MOODY_GUARD_MODEL=
MOODY_STT_BACKEND=openai            # openai (QVAC) | wyoming (faster-whisper)
MOODY_TTS_BACKEND=openai            # openai (QVAC Supertonic 3) | wyoming (Piper)
MOODY_TTS_VOICE=F1                  # Supertonic voice (F1..F5, M1..M5); Piper voice with wyoming
# classic stack (compose.classic.yaml)
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=bge-m3
WHISPER_MODEL=small-int8
PIPER_VOICE=it_IT-paola-medium      # check the voice's MODEL_CARD license

# --- behaviour & privacy -----------------------------------------------------------
MOODY_RETENTION_DAYS=30             # mood journal / reminders hard retention
MOODY_LOG_TRANSCRIPTS=false         # keep false in production
MOODY_ESCALATION=ask                # ask | auto (auto notifies on distress without asking)
# random, generated by setup.sh
MOODY_NTFY_TOPIC=

# --- optional: Home Assistant MCP server ---------------------------------------------
# e.g. http://homeassistant.lan:8123/api/mcp  (token in deploy/secrets/ha_token)
MOODY_HA_MCP_URL=

# --- enterprise only (compose.enterprise.yaml) ----------------------------------------
KEYCLOAK_VERSION=26.8.2
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=
MOODY_GATEWAY_CLIENT_SECRET=
